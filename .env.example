# ── Choose your LLM ─────────────────────────────────────────────
# openai | anthropic | openrouter | grok | gemini | ollama
LLM_PROVIDER=openai
# Optional: override the provider's default model
# LLM_MODEL=gpt-5.4-mini

# Add the key for the provider you picked
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# XAI_API_KEY=xai-...
# GEMINI_API_KEY=...

# Optional: a different provider/model for the quality-control evaluator
# EVALUATOR_PROVIDER=openai
# EVALUATOR_MODEL=gpt-5.4-mini

# Optional: embeddings for RAG (defaults to the chat provider, then OpenAI/OpenRouter;
# falls back to keyword search when none is available)
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small

# ── Notifications (optional) ────────────────────────────────────
PUSHOVER_USER=u...
PUSHOVER_TOKEN=a...
# Telegram owner console
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# ── Profile ─────────────────────────────────────────────────────
TWIN_NAME=Agha Umair Ahmed
